{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": [
    "src/**/*",
    "middleware/**/*",
    "utils/**/*",
    "schemas/**/*",
    "app.ts",
    "prisma/**/*",
    "prisma.config.ts"
  ],
  "ts-node": {
    "files": true
  }
}
