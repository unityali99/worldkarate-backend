generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  INSTRUCTOR
  ADMIN
}

model User {
  id                Int              @id @unique @default(autoincrement())
  firstName         String
  lastName          String
  email             String           @unique
  password          String
  role              Role             @default(USER)
  verified          Boolean          @default(false)
  verificationKey   String           @unique
  OTP               Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  courses           UsersOnCourses[]
  instructedCourses Course[]         @relation("InstructorCourses")
  transactions      Transaction[]
  isAdmin           Boolean          @default(false)
}

model Course {
  id           Int                     @id @unique @default(autoincrement())
  title        String
  description  String
  price        Int // in Rials
  img          String
  link         String?
  previewLinks String[]
  instructorId Int?
  instructor   User?                   @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: SetNull)
  users        UsersOnCourses[]
  transactions TransactionsOnCourses[]
}

model Transaction {
  id                    Int                     @id @unique @default(autoincrement())
  isPaid                Boolean                 @default(false) // becomes true after verification
  authority             String                  @unique // ZarinPal's `authority`, created once per payment attempt
  gatewayRefId          String?                 @unique // ZarinPal's `ref_id`, set only after a successful verification
  totalPrice            Int // sum of course prices
  user                  User                    @relation(fields: [userId], references: [id])
  userId                Int
  transactionsOnCourses TransactionsOnCourses[]
  usersOnCourses        UsersOnCourses[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([gatewayRefId])
  @@index([userId])
  @@index([authority])
}

model UsersOnCourses {
  user          User        @relation(fields: [userId], references: [id])
  userId        Int
  course        Course      @relation(fields: [courseId], references: [id])
  courseId      Int
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  transactionId Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@id([userId, courseId])
  @@index([transactionId])
}

model TransactionsOnCourses {
  course          Course      @relation(fields: [courseId], references: [id])
  courseId        Int
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  transactionId   Int
  priceAtPurchase Int // course price in Rials, frozen at checkout
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@id([transactionId, courseId])
}

model Newsletter {
  id    Int    @id @default(autoincrement())
  email String @unique
}
